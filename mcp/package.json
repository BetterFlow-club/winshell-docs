{
  "name": "@winshell/docs-mcp",
  "version": "0.1.1",
  "description": "MCP server for the winshell docs: lets AI assistants search and read how to configure winshell and build shells.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "winshell-docs-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "pages"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/copy-pages.mjs && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "check": "npm run build && node test/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BetterFlow-club/winshell-docs.git",
    "directory": "mcp"
  },
  "homepage": "https://betterflow-club.github.io/winshell-docs/",
  "bugs": {
    "url": "https://github.com/BetterFlow-club/winshell-docs/issues"
  }
}
